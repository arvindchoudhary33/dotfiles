#!/bin/sh
# Install fisher (if missing) and sync plugins from ~/.config/fish/fish_plugins.
# Re-runs whenever fish_plugins changes.
# fish_plugins hash: {{ include "private_dot_config/private_fish/fish_plugins" | sha256sum }}
set -e
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
if ! command -v fish >/dev/null 2>&1; then
    # Fail (instead of skipping) so chezmoi retries on the next apply
    echo "fish is not installed: install it, then run 'chezmoi apply' again" >&2
    exit 1
fi
fish -c '
if not functions -q fisher
    curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
end
fisher update
'
