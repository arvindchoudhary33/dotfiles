font_family      JetBrainsMono Nerd Font
background_opacity .80
font_size        16.0
window_padding_width 10
# hide_window_decorations yes
confirm_os_window_close 0
wheel_scroll_multiplier 1.0
wheel_scroll_min_lines 1
dynamic_background_opacity yes
allow_remote_control yes

# Pass Ctrl+Shift+J/K to Neovim (CSI u sequences for kitty keyboard protocol)
map ctrl+shift+j send_text all \x1b[106;6u
map ctrl+shift+k send_text all \x1b[107;6u

# Copy/paste with Ctrl+C and Ctrl+V
map ctrl+c copy_or_interrupt
map ctrl+shift+v paste_from_clipboard

{{- if eq .chezmoi.os "darwin" }}

# macOS: Cmd+Enter toggles fullscreen (overrides kitty's default new_window)
map cmd+enter toggle_fullscreen

# macOS: Cmd+1..9,0 jump to tab 1..10
map cmd+1 goto_tab 1
map cmd+2 goto_tab 2
map cmd+3 goto_tab 3
map cmd+4 goto_tab 4
map cmd+5 goto_tab 5
map cmd+6 goto_tab 6
map cmd+7 goto_tab 7
map cmd+8 goto_tab 8
map cmd+9 goto_tab 9
map cmd+0 goto_tab 10
{{- end }}

# Minimal tab bar: no boxes, just "1 name", active tab bold
tab_bar_edge bottom
tab_bar_style separator
tab_separator "  "
tab_bar_margin_width 8
tab_bar_margin_height 4 0
tab_title_template "{index} {title}"
active_tab_font_style bold
inactive_tab_font_style normal

# Toggle transparency
map ctrl+shift+a set_background_opacity +0.05
map ctrl+shift+z set_background_opacity -0.05
map ctrl+shift+backspace set_background_opacity default
map ctrl+shift+t toggle_background_opacity

# Theme colors (managed by apply-theme)
# BEGIN_KITTY_THEME
# Rosé Pine
include current-theme.conf
# END_KITTY_THEME
